# ─── Render / Docker build exclusions ────────────────────────────────────────
# Keeps the deployed image/slug lean.
# NOTE: Do NOT add *.pkl here — the prediction endpoint may depend on model files.

venv/
.git/
.github/
tests/
docs/
*.md
*.pyc
__pycache__/
local_test_images/
sample_data.csv

# Local configuration and Firebase credentials (never include in deployment context)
.env
.env.*
**/.env
**/.env.*
**/*service-account*.json
*.pem
*.p12
*.pfx

# Large local build output
**/node_modules/
**/.venv/
**/venv/
