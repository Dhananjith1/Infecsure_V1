# JWT
JWT_SECRET_KEY=replace-with-a-random-secret-before-running
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Firebase
FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json
FIREBASE_PROJECT_ID=infecsure-5d901
FIREBASE_WEB_API_KEY=your-firebase-web-api-key

# Demo account seeding is off by default. Enable only for an isolated non-production project.
INFEC_SURE_ALLOW_DEMO_SEEDING=false

# Optional startup seeding. Leave blank to skip creating default accounts.
SEED_ICNO_PASSWORD=
SEED_SISTER_PASSWORD=
SEED_LAB_PASSWORD=
SEED_DOCTOR_PASSWORD=
SEED_STAFF_PASSWORD=

# Email (MoH Notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# App
APP_ENV=development
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173","https://infecsure.web.app"]
